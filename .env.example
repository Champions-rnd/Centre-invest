# ChatCI proxy key for ElevenLabs Scribe v2. Save the real key in .env.
HR_CHATCI_API_KEY=
HR_API_PORT=3001
# Optional SQLite path. By default the archive is in .hr-data/interviews.sqlite.
HR_DB_PATH=

# Optional OpenAI-compatible text model. Include /v1 if required by the provider.
HR_COACH_BASE_URL=
HR_COACH_MODEL=
HR_COACH_API_KEY=
