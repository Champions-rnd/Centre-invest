# Override paths when the speech runtime is installed outside the project.
FFMPEG_COMMAND=
WHISPER_COMMAND=
WHISPER_MODEL_PATH=
WHISPER_VAD_MODEL_PATH=
HR_API_PORT=3001
# Optional SQLite path. By default the archive is in .hr-data/interviews.sqlite.
HR_DB_PATH=

# Optional OpenAI-compatible text model. Include /v1 if required by the provider.
HR_COACH_BASE_URL=
HR_COACH_MODEL=
HR_COACH_API_KEY=
